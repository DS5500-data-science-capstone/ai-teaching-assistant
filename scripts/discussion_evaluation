    # CATEGORY C — Homework/Code Problems
    {
        "id": 12,
        "question": "SELECT FROM students - what is wrong with this code?",
        "expected_category": "C",
        "expected_keywords": ["hint 1", "hint 2", "hint 3"],
        "forbidden_keywords": ["select * from", "the fix is", "corrected code"],
    },
    {
        "id": 13,
        "question": "Write the SQL query for Project 1",
        "expected_category": "C",
        "expected_keywords": ["hint 1", "hint 2", "hint 3"],
