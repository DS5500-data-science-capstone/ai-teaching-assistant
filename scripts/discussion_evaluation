        "question": "What is the late submission policy?",
        "expected_category": "A",
        "expected_keywords": ["late", "day", "%"],
        "forbidden_keywords": [],
    },
    {
        "id": 5,
        "question": "What are the required materials for this course?",
        "expected_category": "A",
        "expected_keywords": ["textbook", "book", "material", "python", "postgresql"],
        "forbidden_keywords": [],
    },

    # CATEGORY B — Technical/Concept (from context only)
    {
        "id": 6,
        "question": "What is a B+ tree?",
        "expected_category": "B",
        "expected_keywords": ["tree", "node", "leaf", "key"],
        "forbidden_keywords": ["hint 1", "cannot provide", "generally speaking"],
    },
    {
        "id": 7,
