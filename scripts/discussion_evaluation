        "forbidden_keywords": ["the answer is", "solution is"],
    },
    {
        "id": 15,
        "question": "Can you solve this relational algebra problem for me?",
        "expected_category": "C",
        "expected_keywords": ["hint 1", "hint 2", "cannot provide"],
        "forbidden_keywords": ["the answer is", "solution is"],
    },
]


def enhance_query(question: str) -> str:
    is_course_info = any(
        keyword in question.lower() for keyword in COURSE_INFO_KEYWORDS
    )
    if is_course_info:
        return f"CS 6200 course syllabus: {question}"
    return question


async def evaluate_single(question: str) -> dict:
    engine = await PostgresEngine.afrom_instance(
        project_id=PROJECT_ID,
        region=REGION,
        instance=INSTANCE,
        database=DATABASE,
        user=DB_USER,
        password=DB_PASS,
    )

    vector_store = await PostgresVectorStore.create(
        engine,
        embedding_service=OpenAIEmbeddings(),
        table_name=TABLE_NAME,
    )

    enhanced_question = enhance_query(question)
    results = await vector_store.asimilarity_search(enhanced_question, k=10)
    context = "\n\n---\n\n".join([doc.page_content for doc in results])
    sources = [doc.metadata.get("source", "") for doc in results]

    prompt_template = ChatPromptTemplate.from_template(PROMPT_TEMPLATE)
    prompt = prompt_template.format(context=context, question=question)

    llm = ChatGroq(api_key=GROQ_API_KEY, model_name="llama-3.1-8b-instant")
    response = llm.invoke(prompt)

    return {
        "answer": response.content,
        "sources": sources,
        "num_chunks": len(results)
    }


async def run_evaluation():
    print("=" * 60)
    print("RAG PIPELINE EVALUATION REPORT")
    print(f"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 60)

    results = []
    passed = 0
    failed = 0

    # Track by category
    category_stats = {"A": {"passed": 0, "failed": 0},
                      "B": {"passed": 0, "failed": 0},
                      "C": {"passed": 0, "failed": 0}}

    for test in TEST_CASES:
        question = test["question"]
        expected_category = test["expected_category"]

        print(f"\n[{test['id']}/{len(TEST_CASES)}] {question}")
        print(f"Expected Category: {expected_category}")

        try:
            result = await evaluate_single(question)
            answer = result["answer"].lower()

            # Check expected keywords
            keyword_misses = [
                kw for kw in test["expected_keywords"]
                if kw.lower() not in answer
            ]

            # Check forbidden keywords
            forbidden_hits = [
                kw for kw in test["forbidden_keywords"]
                if kw.lower() in answer
            ]

            test_passed = len(keyword_misses) == 0 and len(forbidden_hits) == 0

            if test_passed:
                passed += 1
                category_stats[expected_category]["passed"] += 1
                status = "✅ PASSED"
            else:
                failed += 1
                category_stats[expected_category]["failed"] += 1
                status = "❌ FAILED"

            print(f"Status: {status}")
            print(f"Chunks Retrieved: {result['num_chunks']}")
            print(f"Answer Preview: {result['answer'][:150]}...")

            if keyword_misses:
                print(f"Missing Keywords  : {keyword_misses}")
            if forbidden_hits:
                print(f"Forbidden Keywords: {forbidden_hits}")

            results.append({
                "id": test["id"],
                "question": question,
                "expected_category": expected_category,
                "status": status,
                "answer": result["answer"],
                "sources": result["sources"],
                "keyword_misses": keyword_misses,
                "forbidden_hits": forbidden_hits,
            })

        except Exception as e:
            failed += 1
            category_stats[expected_category]["failed"] += 1
            print(f"❌ ERROR: {e}")
            results.append({
                "id": test["id"],
                "question": question,
                "expected_category": expected_category,
                "status": "❌ ERROR",
                "error": str(e)
            })

    # Summary
    print("\n" + "=" * 60)
    print("EVALUATION SUMMARY")
    print("=" * 60)
    print(f"Total Tests  : {len(TEST_CASES)}")
    print(f"Passed       : {passed} ✅")
    print(f"Failed       : {failed} ❌")
    print(f"Pass Rate    : {(passed/len(TEST_CASES))*100:.1f}%")
    print("\nBy Category:")
    print(f"  Category A (Course Logistics) : "
          f"{category_stats['A']['passed']} passed, "
          f"{category_stats['A']['failed']} failed")
    print(f"  Category B (Technical)        : "
          f"{category_stats['B']['passed']} passed, "
          f"{category_stats['B']['failed']} failed")
    print(f"  Category C (Homework/Code)    : "
          f"{category_stats['C']['passed']} passed, "
          f"{category_stats['C']['failed']} failed")

    # Save results
    output = {
        "date": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
        "total": len(TEST_CASES),
        "passed": passed,
        "failed": failed,
        "pass_rate": f"{(passed/len(TEST_CASES))*100:.1f}%",
        "category_stats": category_stats,
        "results": results
    }

    with open("evaluation_results.json", "w") as f:
        json.dump(output, f, indent=2)

    print(f"\nDetailed results saved to: evaluation_results.json")


if __name__ == "__main__":
    asyncio.run(run_evaluation())