# Local artifacts / caches
# =========================
artifacts/
reports/
.tmp_compare_models/
tmp/
.cache/
cache/

# Vector DB / Chroma
chroma*/
chroma_*
chroma

# Hugging Face / Transformers cache (optional; keep if you want local caches ignored)
.hf_cache/
transformers_cache/
# (Most HF caches are in user home, but some projects put them in repo.)

