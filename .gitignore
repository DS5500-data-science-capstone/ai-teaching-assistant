# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# Common secret folders
secrets/
credentials/
config/secrets/

# Service account keys (common naming)
*.key.json
*service-account*.json
*gcp*.json
*credentials*.json

# If you keep a key locally at a known path, do NOT put it in repo.
# Prefer putting keys under ./secrets/ and keep that ignored.

# =========================
# Virtual environments
# =========================
.venv/
venv/
__pycache__/
*.pyc

